# Copy to .env.local and adjust. Only VITE_* variables are exposed to the browser bundle,
# so never put secrets in them. All VITE_* values are validated in src/shared/config/env.ts.

# Base URL for the main backend. Relative paths go through the dev proxy below.
VITE_API_BASE_URL=/api

# Serve API responses from the in-browser MSW mocks (dev server only).
VITE_ENABLE_MOCKS=true

# Dev-server only: forward /api to a real backend (used when mocks are disabled).
# API_PROXY_TARGET=http://localhost:8080
